msgstr "envoyer l'e-mail de validation"

msgid "email address"
msgstr "adresse e-mail"

#, python-format
msgid "Shown with your questions and answers. %(min)d to 30 characters: letters, numbers, spaces, hyphens (-) and underscores (_)."
msgstr "Affiché avec vos questions et réponses. De %(min)d à 30 caractères : lettres, chiffres, espaces, tirets (-) et tirets bas (_)."

msgid "We'll email you a link to confirm it. It's never shown publicly."
msgstr "Nous vous enverrons un lien pour la confirmer. Elle n'est jamais affichée publiquement."

msgid "Shown on your profile."
msgstr "Affiché sur votre profil."

msgid "Email address"
msgstr "Adresse e-mail"

