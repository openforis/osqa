msgid "You might know the answer: <em>%(title)s</em> (you've answered %(counter)s question tagged %(tag)s)"
msgid_plural "You might know the answer: <em>%(title)s</em> (you've answered %(counter)s questions tagged %(tag)s)"
msgstr[0] "Vous connaissez peut-être la réponse : <em>%(title)s</em> (vous avez répondu à %(counter)s question avec l’étiquette %(tag)s)"
msgstr[1] "Vous connaissez peut-être la réponse : <em>%(title)s</em> (vous avez répondu à %(counter)s questions avec l’étiquette %(tag)s)"

#, python-format
msgid "Your question <em>%(title)s</em> has answers. If one solved it, accept it so others know."
msgstr "Votre question <em>%(title)s</em> a reçu des réponses. Si l'une d'elles l'a résolue, acceptez-la pour que les autres le sachent."

msgid "No notifications yet. Answers to your questions, comments on your posts, mentions of your name and badges you earn will appear here."
msgstr "Aucune notification pour l'instant. Les réponses à vos questions, les commentaires sur vos publications, les mentions de votre nom et les badges que vous obtenez apparaîtront ici."

#, python-format
msgid "Notifications here don't depend on your emails. To choose which emails you get, open your <a href=\"%(url)s\">email settings</a>."
msgstr "Les notifications affichées ici ne dépendent pas de vos e-mails. Pour choisir les e-mails que vous recevez, ouvrez vos <a href=\"%(url)s\">paramètres e-mail</a>."

