msgstr "Veuillez utiliser la notation décimale pointée pour les adresses IP"

msgid "Allow ips"
msgstr "IP autorisées"

msgid "Comma separated list of ips allowed to access the site while in maintenance"
msgstr "Liste, séparée par des virgules, des IP autorisées à accéder au site pendant la maintenance"

msgid "Message"
msgstr "Message"

msgid "A message to display to your site visitors while in maintainance mode"
msgstr "Un message à afficher aux visiteurs du site pendant le mode maintenance"

msgid "Default"
msgstr "Par défaut"

msgid "Default with sidebar"
msgstr "Par défaut avec barre latérale"

msgid "None"
msgstr "Aucun"

