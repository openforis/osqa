msgstr "%(user)s a publié une nouvelle page intitulée %(page)s"

#, python-format
msgid "%(user)s edited %(post_desc)s (suggested edit approved by %(reviewer)s)"
msgstr "%(user)s a modifié %(post_desc)s (modification suggérée approuvée par %(reviewer)s)"

msgid "rejected a suggested edit"
msgstr "a refusé une modification suggérée"

#, python-format
msgid "%(user)s rejected an edit suggested by %(author)s to %(post_desc)s: %(reason)s"
msgstr "%(user)s a refusé une modification suggérée par %(author)s pour %(post_desc)s : %(reason)s"

msgid "someone"
msgstr "quelqu'un"

