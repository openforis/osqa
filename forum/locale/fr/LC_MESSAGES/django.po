msgid "profile"
msgstr "profil"

msgid "gave bonus"
msgstr "a accordé un bonus"

#, python-format
msgid "You have penalized %s in %s reputation points."
msgstr "Vous avez pénalisé %s de %s points de réputation."

msgid "unknown"
msgstr "inconnu"

#, python-format
msgid "%(user)s awarded an extra %(value)s reputation points to %(users)s: %(message)s"
msgstr "%(user)s a accordé %(value)s points de réputation supplémentaires à %(users)s : %(message)s"

#, python-format
msgid "%(user)s penalised %(users)s in %(value)s reputation points: %(message)s"
msgstr "%(user)s a pénalisé %(users)s de %(value)s points de réputation : %(message)s"

msgid "gave reputation points"
msgstr "a accordé des points de réputation"

#, python-format
msgid "%(user)s awarded an extra %(value)s reputation points to %(users)s"
msgstr "%(user)s a accordé %(value)s points de réputation supplémentaires à %(users)s"

#, python-format
msgid "%(user)s penalised %(users)s in %(value)s reputation points"
msgstr "%(user)s a pénalisé %(users)s de %(value)s points de réputation"

msgid "was awarded"
msgstr "a reçu"

#, python-format
msgid "Congratulations, you have received a badge '%(badge_name)s'. <a href=\"%(badge_url)s\">Find out who has it, too</a>."
msgstr "Félicitations, vous avez reçu le badge « %(badge_name)s ». <a href=\"%(badge_url)s\">Découvrez qui d'autre l'a obtenu</a>."

#, python-format
msgid "%(user)s %(were_was)s awarded the %(badge_name)s badge"
msgstr "%(user)s %(were_was)s reçu le badge %(badge_name)s"

msgid "were"
msgstr "avez"

msgid "was"
msgstr "a"

msgid "suspended"
msgstr "suspendu"

#, python-format
msgid "%(user)s reported %(reported)s : %(msg)s"
msgstr "%(user)s a signalé %(reported)s : %(msg)s"

msgid "N/A"
msgstr "N/D"

#, python-format
msgid "for %s days"
msgstr "pendant %s jours"

msgid "indefinetely"
msgstr "indéfiniment"

#, python-format
msgid "%(user)s suspended %(users)s %(suspension)s: %(msg)s"
msgstr "%(user)s a suspendu %(users)s %(suspension)s : %(msg)s"

msgid "Bad behaviour"
msgstr "Mauvais comportement"

msgid "confirmed an answer for a new version"
msgstr "a confirmé une réponse pour une nouvelle version"

#, python-format
msgid "%(user)s confirmed that %(post_desc)s still works in %(version)s"
msgstr "%(user)s a confirmé que %(post_desc)s fonctionne toujours en %(version)s"

msgid "since must be a date (YYYY-MM-DD) or an ISO 8601 date and time."
msgstr "since doit être une date (AAAA-MM-JJ) ou une date et heure ISO 8601."

msgid "Not a date."
msgstr "Ce n'est pas une date."

#, python-format
msgid "%(name)s must be a whole number from %(min)d to %(max)d."
msgstr "%(name)s doit être un nombre entier entre %(min)d et %(max)d."

msgid "Out of range."
msgstr "Hors limites."

#, python-format
msgid "%(name)s must be one of: %(choices)s."
msgstr "%(name)s doit valoir l'une de ces valeurs : %(choices)s."

msgid "Unknown value."
msgstr "Valeur inconnue."

msgid "Send the request body as JSON (Content-Type: application/json)."
msgstr "Envoyez le corps de la requête en JSON (Content-Type: application/json)."

#, python-format
msgid "The request body is larger than %d KB."
msgstr "Le corps de la requête dépasse %d Ko."

msgid "The request body is not valid JSON."
msgstr "Le corps de la requête n'est pas du JSON valide."

msgid "The request body must be a JSON object."
msgstr "Le corps de la requête doit être un objet JSON."

#, python-format
msgid "%s must be a string."
msgstr "%s doit être une chaîne de caractères."

msgid "Must be a string."
msgstr "Doit être une chaîne de caractères."

#, python-format
msgid "%s is required."
msgstr "%s est obligatoire."

msgid "This field is required."
msgstr "Ce champ est obligatoire."

msgid "The cursor is not valid for this list; use the next link of a previous page."
msgstr "Ce curseur n'est pas valide pour cette liste ; utilisez le lien next d'une page précédente."

msgid "Not valid."
msgstr "Non valide."

msgid "Send the token as \"Authorization: Bearer <token>\"."
msgstr "Envoyez le jeton sous la forme « Authorization: Bearer <token> »."

msgid "This token is not valid. It may have been revoked."
msgstr "Ce jeton n'est pas valide. Il a peut-être été révoqué."

#, python-format
msgid "This token expired on %s. Create a new one on your account page."
msgstr "Ce jeton a expiré le %s. Créez-en un nouveau sur la page de votre compte."

msgid "This account is suspended, so its tokens can't be used."
msgstr "Ce compte est suspendu : ses jetons ne peuvent pas être utilisés."

msgid "Confirm your email address before using the API."
msgstr "Confirmez votre adresse e-mail avant d'utiliser l'API."

msgid "This site doesn't accept changes through the API at the moment."
msgstr "Ce site n'accepte pas de modifications par l'API pour le moment."

msgid "This needs a personal access token: send \"Authorization: Bearer <token>\"."
msgstr "Il faut un jeton d'accès personnel : envoyez « Authorization: Bearer <token> »."

#, python-format
msgid "This token doesn't have the %s scope."
msgstr "Ce jeton n'a pas la portée %s."

#, python-format
msgid "Too many requests: at most %(limit)d per minute. Try again in %(seconds)d seconds."
msgstr "Trop de requêtes : %(limit)d par minute au maximum. Réessayez dans %(seconds)d secondes."

msgid "The administrators of this site have turned the API off."
msgstr "Les administrateurs de ce site ont désactivé l'API."

#, python-format
msgid "%(method)s is not allowed here; use %(allowed)s."
msgstr "%(method)s n'est pas autorisé ici ; utilisez %(allowed)s."

msgid "There is nothing here, or you may not see it."
msgstr "Il n'y a rien ici, ou vous n'avez pas le droit de le voir."

msgid "Something went wrong on our side."
msgstr "Un problème est survenu de notre côté."

msgid "q is required: what to look for."
msgstr "q est obligatoire : ce que vous cherchez."

msgid "Confirm your email address first: open the link we emailed you, or ask for a new one on the site."
msgstr "Confirmez d'abord votre adresse e-mail : ouvrez le lien que nous vous avons envoyé, ou demandez-en un nouveau sur le site."

#, python-format
msgid "Members with less than %d reputation points post on the web site, where they answer a CAPTCHA."
msgstr "Les membres ayant moins de %d points de réputation publient sur le site web, où ils répondent à un CAPTCHA."

msgid "This looks like spam to our spam filter, so it wasn't posted."
msgstr "Notre filtre anti-spam considère ce contenu comme du spam : il n'a donc pas été publié."

msgid "tags must be a list of names or a string."
msgstr "tags doit être une liste de noms ou une chaîne de caractères."

msgid "Must be a list of names or a string."
msgstr "Doit être une liste de noms ou une chaîne de caractères."

msgid "This question is closed: it takes no new answers."
msgstr "Cette question est fermée : elle n'accepte plus de nouvelles réponses."

#, python-format
msgid "At least %d characters required on comment body."
msgstr "Le corps du commentaire doit contenir au moins %d caractères."

msgid "Too short."
msgstr "Trop court."

#, python-format
msgid "No more than %d characters on comment body."
msgstr "Le corps du commentaire ne doit pas dépasser %d caractères."

msgid "Too long."
msgstr "Trop long."

#, python-format
msgid "You need %d reputation points to comment on other members' posts."
msgstr "Il vous faut %d points de réputation pour commenter les messages des autres membres."

msgid "vote must be up, down or none."
msgstr "vote doit valoir up, down ou none."

msgid "You can't vote on your own posts."
msgstr "Vous ne pouvez pas voter pour vos propres messages."

#, python-format
msgid "Voting up needs %(needed)d reputation points (you have %(have)d)."
msgstr "Voter pour nécessite %(needed)d points de réputation (vous en avez %(have)d)."

#, python-format
msgid "Voting down needs %(needed)d reputation points (you have %(have)d)."
msgstr "Voter contre nécessite %(needed)d points de réputation (vous en avez %(have)d)."

#, python-format
msgid "A vote can't be changed more than %d day after it was cast."
msgid_plural "A vote can't be changed more than %d days after it was cast."
msgstr[0] "Un vote ne peut pas être modifié plus de %d jour après avoir été émis."
msgstr[1] "Un vote ne peut pas être modifié plus de %d jours après avoir été émis."

#, python-format
msgid "You have used your %d votes for today."
msgstr "Vous avez utilisé vos %d votes de la journée."

msgid "Accepting answers is turned off on this site."
msgstr "L'acceptation des réponses est désactivée sur ce site."

msgid "Only the asker (or a moderator) can accept an answer."
msgstr "Seul l'auteur de la question (ou un modérateur) peut accepter une réponse."

msgid "This question already has an accepted answer."
msgid_plural "This question has reached the limit of accepted answers."
msgstr[0] "Cette question a déjà une réponse acceptée."
msgstr[1] "Cette question a atteint la limite de réponses acceptées."

msgid "The author of this answer has reached the limit of accepted answers in this question."
msgstr "L'auteur de cette réponse a atteint la limite de réponses acceptées pour cette question."

#, python-format
msgid "Answers to: %s"
msgstr "Réponses à : %s"

#, python-format
msgid "Answer by %s"
msgstr "Réponse de %s"

#, python-format
msgid "Comment by %(cauthor)s on %(pauthor)s's %(qora)s"
msgstr "Commentaire de %(cauthor)s sur la %(qora)s de %(pauthor)s"

