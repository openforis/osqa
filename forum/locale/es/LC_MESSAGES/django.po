msgstr "Es la primera vez que inicia sesión con %(provider)s. Revise sus datos para crear su cuenta en %(site)s."

msgid "Your account isn't created yet. Please check:"
msgstr "Su cuenta aún no se ha creado. Revise lo siguiente:"

msgid "or"
msgstr "o"

msgid "Leave this field empty"
msgstr "Deje este campo vacío"

msgid "Next, check your email: open the link we send you to finish creating your account."
msgstr "A continuación, revise su correo: abra el enlace que le enviaremos para terminar de crear su cuenta."

msgid "Next, we'll email you a link to confirm your address."
msgstr "Después le enviaremos un enlace para confirmar su dirección de correo."

msgid "Create account"
msgstr "Crear cuenta"

msgid "Already have an account?"
msgstr "¿Ya tiene una cuenta?"

msgid "Why create an account?"
msgstr "¿Por qué crear una cuenta?"

msgid "Confirm your email address to start posting."
msgstr "Confirme su dirección de correo electrónico para empezar a publicar."

#, python-format
msgid "We sent a link to <span class=\"confirm-banner-email\">%(email)s</span>."
msgstr "Hemos enviado un enlace a <span class=\"confirm-banner-email\">%(email)s</span>."

msgid "Send it again"
msgstr "Volver a enviarlo"

msgid "Change the address"
msgstr "Cambiar la dirección"

msgid "Confirm your email address"
msgstr "Confirme su dirección de correo electrónico"

#, python-format
msgid "Your email address <span class=\"auth-address\">%(email)s</span> is confirmed."
msgstr "Su dirección de correo electrónico <span class=\"auth-address\">%(email)s</span> está confirmada."

#, python-format
msgid "You asked to change it to <span class=\"auth-address\">%(email)s</span>: use the link we sent there."
msgstr "Ha pedido cambiarla a <span class=\"auth-address\">%(email)s</span>: use el enlace que enviamos allí."

msgid "Go to the questions"
msgstr "Ir a las preguntas"

#, python-format
msgid "We sent a link to <span class=\"auth-address\">%(email)s</span>. Open it to confirm your address; it works once, for %(hours)s hour."
msgid_plural "We sent a link to <span class=\"auth-address\">%(email)s</span>. Open it to confirm your address; it works once, for %(hours)s hours."
msgstr[0] "Hemos enviado un enlace a <span class=\"auth-address\">%(email)s</span>. Ábralo para confirmar su dirección; funciona una vez, durante %(hours)s hora."
msgstr[1] "Hemos enviado un enlace a <span class=\"auth-address\">%(email)s</span>. Ábralo para confirmar su dirección; funciona una vez, durante %(hours)s horas."
msgstr[2] "Hemos enviado un enlace a <span class=\"auth-address\">%(email)s</span>. Ábralo para confirmar su dirección; funciona una vez, durante %(hours)s horas."

msgid "Nothing arrived after a few minutes? Check your spam folder, or send a new link (the old one stops working)."
msgstr "¿No ha llegado nada después de unos minutos? Revise su carpeta de spam o envíe un enlace nuevo (el anterior dejará de funcionar)."

msgid "Send a new link"
msgstr "Enviar un enlace nuevo"

msgid "Use another email address"
msgstr "Usar otra dirección de correo electrónico"

msgid "Enter the email address you signed up with and we'll send you a new confirmation link."
msgstr "Introduzca la dirección de correo electrónico con la que se registró y le enviaremos un nuevo enlace de confirmación."

msgid "Send the confirmation link"
msgstr "Enviar el enlace de confirmación"

msgid "Already confirmed?"
msgstr "¿Ya la ha confirmado?"

msgid "Confirm it's you"
msgstr "Confirme que es usted"

msgid "Open this link in the browser where you asked for it, signed in to your account."
msgstr "Abra este enlace en el navegador donde lo pidió, con la sesión iniciada en su cuenta."

#, python-format
msgid "We emailed you a link. Open it in this browser within %(minutes)s minutes; it works once."
msgstr "Le enviamos un enlace por correo. Ábralo en este navegador en menos de %(minutes)s minutos; funciona una vez."

msgid "This link doesn't work any more. Ask for a new one."
msgstr "Este enlace ya no funciona. Pida uno nuevo."

msgid "For your security, confirm it's you before changing how you sign in or your email address. Then send the form on the page you come back to again."
msgstr "Por su seguridad, confirme que es usted antes de cambiar cómo inicia sesión o su dirección de correo. Después, vuelva a enviar el formulario en la página a la que regrese."

msgid "Confirm"
msgstr "Confirmar"

msgid "Code from your authenticator app"
msgstr "Código de su aplicación de autenticación"

msgid "A recovery code works too."
msgstr "También sirve un código de recuperación."

msgid "Confirm with the code"
msgstr "Confirmar con el código"

#, python-format
msgid "Your account has no password or two-step verification, so we email you a link instead. It works once, for %(minutes)s minutes, in this browser."
msgstr "Su cuenta no tiene contraseña ni verificación en dos pasos, así que le enviamos un enlace por correo. Funciona una vez, durante %(minutes)s minutos, en este navegador."

msgid "Email me a link"
msgstr "Enviarme un enlace"

msgid "Confirm with a passkey"
msgstr "Confirmar con una llave de acceso"

msgid "Cancel the email change?"
msgstr "¿Cancelar el cambio de correo electrónico?"

#, python-format
msgid "Someone asked to change the email address of the account <strong>%(name)s</strong> to %(email)s."
msgstr "Alguien ha pedido cambiar la dirección de correo electrónico de la cuenta <strong>%(name)s</strong> a %(email)s."

msgid "Cancelling keeps the current address and signs out every browser and device, including any an intruder may be using."
msgstr "Al cancelar se conserva la dirección actual y se cierra la sesión en todos los navegadores y dispositivos, incluidos los que pueda estar usando un intruso."

msgid "Cancel the change and sign out everywhere"
msgstr "Cancelar el cambio y cerrar la sesión en todas partes"

msgid "It was me, keep the change"
msgstr "Fui yo, mantener el cambio"

#, python-format
msgid "%(prefix)s Confirm your new email address for %(app_name)s"
msgstr "%(prefix)s Confirme su nueva dirección de correo electrónico para %(app_name)s"

msgid "Confirm this address to start using it for your account."
msgstr "Confirme esta dirección para empezar a usarla en su cuenta."

#, python-format
msgid "You receive this email because someone asked to use this address for an account at %(app_name)s. If it wasn't you, ignore it: nothing changes without this link."
msgstr "Recibe este correo porque alguien ha pedido usar esta dirección para una cuenta de %(app_name)s. Si no fue usted, ignórelo: nada cambia sin este enlace."

#, python-format
msgid "You asked to use %(new_email)s for your account %(name)s. Confirm it with the button; until then, emails keep going to your old address. The link works once, for %(hours)s hour."
msgid_plural "You asked to use %(new_email)s for your account %(name)s. Confirm it with the button; until then, emails keep going to your old address. The link works once, for %(hours)s hours."
msgstr[0] "Ha pedido usar %(new_email)s para su cuenta %(name)s. Confírmelo con el botón; hasta entonces, los correos seguirán llegando a su dirección anterior. El enlace funciona una vez, durante %(hours)s hora."
msgstr[1] "Ha pedido usar %(new_email)s para su cuenta %(name)s. Confírmelo con el botón; hasta entonces, los correos seguirán llegando a su dirección anterior. El enlace funciona una vez, durante %(hours)s horas."
msgstr[2] "Ha pedido usar %(new_email)s para su cuenta %(name)s. Confírmelo con el botón; hasta entonces, los correos seguirán llegando a su dirección anterior. El enlace funciona una vez, durante %(hours)s horas."

msgid "Confirm new address"
msgstr "Confirmar la nueva dirección"

#, python-format
msgid "%(prefix)s Your %(app_name)s email address is being changed"
msgstr "%(prefix)s Se está cambiando su dirección de correo electrónico de %(app_name)s"

msgid "If you didn't ask for this, cancel the change."
msgstr "Si usted no lo ha pedido, cancele el cambio."

#, python-format
msgid "You receive this security notice because the email address of your account at %(app_name)s is being changed. These notices are always sent."
msgstr "Recibe este aviso de seguridad porque se está cambiando la dirección de correo electrónico de su cuenta de %(app_name)s. Estos avisos se envían siempre."

#, python-format
msgid "Someone signed in to your account %(name)s asked to change its email address to %(new_email_masked)s. The change happens only when the new address is confirmed; until then, your account keeps this address."
msgstr "Alguien que ha iniciado sesión en su cuenta %(name)s ha pedido cambiar su dirección de correo electrónico a %(new_email_masked)s. El cambio solo se produce cuando se confirma la nueva dirección; hasta entonces, su cuenta conserva esta."

msgid "If this was you, there is nothing to do."
msgstr "Si fue usted, no tiene que hacer nada."

msgid "If it wasn't you, cancel the change: that also signs out every browser and device. Then reset your password."
msgstr "Si no fue usted, cancele el cambio: así también se cierra la sesión en todos los navegadores y dispositivos. Después, restablezca su contraseña."

msgid "Cancel the change"
msgstr "Cancelar el cambio"

msgid "Email address changed"
msgstr "Dirección de correo electrónico cambiada"

msgid "Email change cancelled"
msgstr "Cambio de correo electrónico cancelado"

msgid "This link doesn't work any more"
msgstr "Este enlace ya no funciona"

#, python-format
msgid "Your account now uses <span class=\"auth-address\">%(email)s</span>."
msgstr "Su cuenta usa ahora <span class=\"auth-address\">%(email)s</span>."

msgid "Back to your profile"
msgstr "Volver a su perfil"

msgid "Your account keeps its email address, and every browser and device was signed out. If you didn't ask for the change, someone may know your password: choose a new one now."
msgstr "Su cuenta conserva su dirección de correo electrónico y se ha cerrado la sesión en todos los navegadores y dispositivos. Si usted no pidió el cambio, es posible que alguien conozca su contraseña: elija una nueva ahora."

msgid "Reset your password"
msgstr "Restablecer su contraseña"

msgid "This address is already in use"
msgstr "Esta dirección ya está en uso"

msgid "Another account started using this email address in the meantime, so your address was not changed."
msgstr "Otra cuenta ha empezado a usar esta dirección de correo electrónico mientras tanto, así que su dirección no se ha cambiado."

msgid "The change was already confirmed or cancelled, a newer link was sent, or the link has expired (after 48 hours). You can ask for the change again on your profile."
msgstr "El cambio ya se confirmó o se canceló, se envió un enlace más reciente o el enlace ha caducado (tras 48 horas). Puede volver a solicitar el cambio en su perfil."

#, python-format
msgid "%(prefix)s Your %(app_name)s email address was changed"
msgstr "%(prefix)s Se ha cambiado su dirección de correo electrónico de %(app_name)s"

msgid "An administrator changed the email address of your account."
msgstr "Un administrador ha cambiado la dirección de correo electrónico de su cuenta."

#, python-format
msgid "You receive this security notice because the email address of your account at %(app_name)s was changed. These notices are always sent."
msgstr "Recibe este aviso de seguridad porque se ha cambiado la dirección de correo electrónico de su cuenta de %(app_name)s. Estos avisos se envían siempre."

#, python-format
msgid "An administrator of %(app_name)s changed the email address of your account %(name)s to %(new_email_masked)s. Emails from the site now go there."
msgstr "Un administrador de %(app_name)s ha cambiado la dirección de correo electrónico de su cuenta %(name)s a %(new_email_masked)s. Los correos del sitio se envían ahora a esa dirección."

msgid "If you didn't expect this, reply to this email or contact the site administrators."
msgstr "Si no lo esperaba, responda a este correo o póngase en contacto con los administradores del sitio."

msgid "Email address confirmed"
msgstr "Dirección de correo electrónico confirmada"

#, python-format
msgid "Confirmation links work once, for %(hours)s hour, and only the newest one works. Ask for a new link below."
msgid_plural "Confirmation links work once, for %(hours)s hours, and only the newest one works. Ask for a new link below."
msgstr[0] "Los enlaces de confirmación funcionan una vez, durante %(hours)s hora, y solo funciona el más reciente. Solicite un enlace nuevo a continuación."
msgstr[1] "Los enlaces de confirmación funcionan una vez, durante %(hours)s horas, y solo funciona el más reciente. Solicite un enlace nuevo a continuación."
msgstr[2] "Los enlaces de confirmación funcionan una vez, durante %(hours)s horas, y solo funciona el más reciente. Solicite un enlace nuevo a continuación."

msgid "Send a new confirmation link"
msgstr "Enviar un nuevo enlace de confirmación"

msgid "This email address was already confirmed. There's nothing more to do."
msgstr "Esta dirección de correo electrónico ya estaba confirmada. No tiene que hacer nada más."

#, python-format
msgid "Thank you, %(name)s: your email is now validated. Welcome to %(site)s! You can ask questions, answer and comment."
msgstr "Gracias, %(name)s: su correo electrónico ya está validado. ¡Bienvenido/a a %(site)s! Ya puede hacer preguntas, responder y comentar."

msgid "Ask your first question"
msgstr "Haga su primera pregunta"

msgid "Browse the questions"
msgstr "Explorar las preguntas"

msgid "Error:"
msgstr "Error:"

msgid "Too short"
msgstr "Demasiado corta"

msgid "Weak: add more words"
msgstr "Débil: añada más palabras"

msgid "Fair"
msgstr "Aceptable"

msgid "Good"
msgstr "Buena"

msgid "Strong"
msgstr "Fuerte"

msgid "Too close to your username or email"
msgstr "Demasiado parecida a su nombre de usuario o correo electrónico"

msgid "Password strength:"
msgstr "Seguridad de la contraseña:"

msgid "Password reset links work once, for an hour, and stop working when the password changes or you sign in. Ask for a new one."
msgstr "Los enlaces para restablecer la contraseña funcionan una vez, durante una hora, y dejan de funcionar cuando cambia la contraseña o inicia sesión. Solicite uno nuevo."

msgid "The email change has already been confirmed or cancelled, or the link has expired. If you didn't ask for the change, reset your password to be safe."
msgstr "El cambio de correo electrónico ya se ha confirmado o cancelado, o el enlace ha caducado. Si usted no pidió el cambio, restablezca su contraseña por seguridad."

#, python-format
msgid "%(prefix)s Confirm your email address for %(app_name)s"
msgstr "%(prefix)s Confirme su dirección de correo en %(app_name)s"

msgid "Confirm your email address with one click."
msgstr "Confirme su dirección de correo con un clic."

#, python-format
msgid "You receive this email because a confirmation link was requested for your account at %(app_name)s."
msgstr "Recibe este correo porque se pidió un enlace de confirmación para su cuenta en %(app_name)s."

#, python-format
msgid "Please confirm that this is your email address. The link works once, for %(hours)s hour; earlier links no longer work."
msgid_plural "Please confirm that this is your email address. The link works once, for %(hours)s hours; earlier links no longer work."
msgstr[0] "Confirme que esta es su dirección de correo electrónico. El enlace funciona una vez, durante %(hours)s hora; los enlaces anteriores ya no funcionan."
msgstr[1] "Confirme que esta es su dirección de correo electrónico. El enlace funciona una vez, durante %(hours)s horas; los enlaces anteriores ya no funcionan."
msgstr[2] "Confirme que esta es su dirección de correo electrónico. El enlace funciona una vez, durante %(hours)s horas; los enlaces anteriores ya no funcionan."

msgid "Confirm your email"
msgstr "Confirmar su correo"

msgid "Didn't ask for this? You can ignore this email."
msgstr "¿No lo ha pedido? Puede ignorar este correo."

#, python-format
msgid "%(prefix)s New sign-in to your %(app_name)s account"
msgstr "%(prefix)s Nuevo inicio de sesión en su cuenta de %(app_name)s"

#, python-format
msgid "Someone signed in with %(browser)s. Was it you?"
msgstr "Alguien ha iniciado sesión con %(browser)s. ¿Fue usted?"

#, python-format
msgid "You receive this security notice because your account at %(app_name)s was used from a new browser or device. These notices are always sent while the site has them turned on."
msgstr "Recibe este aviso de seguridad porque su cuenta de %(app_name)s se ha usado desde un navegador o dispositivo nuevo. Estos avisos se envían siempre mientras el sitio los tenga activados."

#, python-format
msgid "Your account %(name)s was just signed in to from a browser or device that hasn't been used with it before."
msgstr "Se acaba de iniciar sesión en su cuenta %(name)s desde un navegador o dispositivo que no se había usado antes con ella."

#, python-format
msgid "When: %(when)s"
msgstr "Cuándo: %(when)s"

#, python-format
msgid "Browser: %(browser)s"
msgstr "Navegador: %(browser)s"

#, python-format
msgid "IP address: %(ip)s"
msgstr "Dirección IP: %(ip)s"

msgid "If this was you, you can ignore this email. If it wasn't, someone knows your password: reset it now. That also signs out every browser and device."
msgstr "Si fue usted, puede ignorar este correo. Si no, alguien conoce su contraseña: restablézcala ahora. Así también se cierra la sesión en todos los navegadores y dispositivos."

#, python-format
msgid "You can also sign out everywhere else and turn on two-step verification on <a href=\"%(security_url)s\" style=\"%(a_style)s\">your security page</a>."
msgstr "También puede cerrar la sesión en todos los demás lugares y activar la verificación en dos pasos en <a href=\"%(security_url)s\" style=\"%(a_style)s\">su página de seguridad</a>."

msgid "Your security page (sign out everywhere else, two-step verification)"
msgstr "Su página de seguridad (cerrar la sesión en los demás lugares, verificación en dos pasos)"

msgid "Sign in with a passkey"
msgstr "Iniciar sesión con una llave de acceso"

#, python-format
msgid "%(prefix)s Your %(app_name)s password was changed"
msgstr "%(prefix)s Se ha cambiado su contraseña de %(app_name)s"

msgid "If you didn't do this, reset your password now."
msgstr "Si no ha sido usted, restablezca su contraseña ahora."

#, python-format
msgid "You receive this security notice because the password of your account at %(app_name)s was changed. These notices are always sent."
msgstr "Recibe este aviso de seguridad porque se ha cambiado la contraseña de su cuenta de %(app_name)s. Estos avisos se envían siempre."

#, python-format
msgid "An administrator set a new password for your account %(name)s."
msgstr "Un administrador ha establecido una contraseña nueva para su cuenta %(name)s."

#, python-format
msgid "A password was created for your account %(name)s: you can now also sign in with it."
msgstr "Se ha creado una contraseña para su cuenta %(name)s: ahora también puede iniciar sesión con ella."

#, python-format
msgid "The password of your account %(name)s was reset with the link we emailed."
msgstr "La contraseña de su cuenta %(name)s se ha restablecido con el enlace que le enviamos por correo."

#, python-format
msgid "The password of your account %(name)s was changed."
msgstr "Se ha cambiado la contraseña de su cuenta %(name)s."

msgid "Every other browser and device was signed out."
msgstr "Se ha cerrado la sesión en todos los demás navegadores y dispositivos."

msgid "If this was you, there is nothing else to do. If it wasn't, reset your password now and check the email address and sign-in methods of your account."
msgstr "Si fue usted, no tiene que hacer nada más. Si no, restablezca su contraseña ahora y revise la dirección de correo electrónico y los métodos de inicio de sesión de su cuenta."

msgid "Choose a new password"
msgstr "Elija una contraseña nueva"

#, python-format
msgid "For the account <strong>%(name)s</strong>. Afterwards you are signed out everywhere and sign in with the new password."
msgstr "Para la cuenta <strong>%(name)s</strong>. Después se cerrará la sesión en todas partes y deberá iniciar sesión con la contraseña nueva."

msgid "Your password isn't changed yet. Please check:"
msgstr "Su contraseña aún no se ha cambiado. Revise lo siguiente:"

msgid "Your account uses two-step verification. A recovery code works too."
msgstr "Su cuenta usa la verificación en dos pasos. También sirve un código de recuperación."

msgid "Remembered it?"
msgstr "¿Ya la recuerda?"

#, python-format
msgid "%(prefix)s Reset your password for %(app_name)s"
msgstr "%(prefix)s Restablezca su contraseña de %(app_name)s"

#, python-format
msgid "Choose a new password. The link works once, for %(minutes)s minute."
msgid_plural "Choose a new password. The link works once, for %(minutes)s minutes."
msgstr[0] "Elija una contraseña nueva. El enlace funciona una vez, durante %(minutes)s minuto."
msgstr[1] "Elija una contraseña nueva. El enlace funciona una vez, durante %(minutes)s minutos."
msgstr[2] "Elija una contraseña nueva. El enlace funciona una vez, durante %(minutes)s minutos."

#, python-format
msgid "You receive this email because a password reset was requested for your account at %(app_name)s."
msgstr "Recibe este correo porque se ha solicitado restablecer la contraseña de su cuenta de %(app_name)s."

#, python-format
msgid "Someone (hopefully you) asked to reset the password of your account %(name)s. Use the button to choose a new one. The link works once, for %(minutes)s minute."
msgid_plural "Someone (hopefully you) asked to reset the password of your account %(name)s. Use the button to choose a new one. The link works once, for %(minutes)s minutes."
msgstr[0] "Alguien (esperamos que usted) ha pedido restablecer la contraseña de su cuenta %(name)s. Use el botón para elegir una nueva. El enlace funciona una vez, durante %(minutes)s minuto."
msgstr[1] "Alguien (esperamos que usted) ha pedido restablecer la contraseña de su cuenta %(name)s. Use el botón para elegir una nueva. El enlace funciona una vez, durante %(minutes)s minutos."
msgstr[2] "Alguien (esperamos que usted) ha pedido restablecer la contraseña de su cuenta %(name)s. Use el botón para elegir una nueva. El enlace funciona una vez, durante %(minutes)s minutos."

msgid "Didn't ask for this? You can ignore this email: your password stays the same, and nobody can change it without this link."
msgstr "¿No lo ha pedido? Puede ignorar este correo: su contraseña no cambia y nadie puede cambiarla sin este enlace."

msgid "Show password"
msgstr "Mostrar contraseña"

#, python-format
msgid "Continue with %(name)s"
msgstr "Continuar con %(name)s"

#, python-format
msgid "Your %(what)s"
msgstr "Su %(what)s"

msgid "Continue"
msgstr "Continuar"

#, python-format
msgid "%(prefix)s Confirm it's you on %(app_name)s"
msgstr "%(prefix)s Confirme que es usted en %(app_name)s"

msgid "Open the link to continue changing your account."
msgstr "Abra el enlace para seguir cambiando su cuenta."

#, python-format
msgid "You receive this email because someone signed in to your account at %(app_name)s asked to confirm it's you. These notices are always sent."
msgstr "Recibe este correo porque alguien con la sesión iniciada en su cuenta de %(app_name)s pidió confirmar su identidad. Estos avisos se envían siempre."

#, python-format
msgid "Open this link in the browser where you asked for it to confirm it's you. It works once, for %(minutes)s minutes."
msgstr "Abra este enlace en el navegador donde lo pidió para confirmar que es usted. Funciona una vez, durante %(minutes)s minutos."

msgid "Confirm and continue"
msgstr "Confirmar y continuar"

msgid "If you didn't ask for this, someone may be using your account: sign out everywhere on your security page."
msgstr "Si no lo pidió, puede que alguien esté usando su cuenta: cierre la sesión en todas partes desde su página de seguridad."

#, python-format
msgid "%(prefix)s Security change on your %(app_name)s account"
msgstr "%(prefix)s Cambio de seguridad en su cuenta de %(app_name)s"

msgid "If you didn't do this, secure your account now."
msgstr "Si no fue usted, proteja su cuenta ahora."

#, python-format
msgid "You receive this security notice because the sign-in settings of your account at %(app_name)s were changed. These notices are always sent."
msgstr "Recibe este aviso de seguridad porque cambió la configuración de inicio de sesión de su cuenta de %(app_name)s. Estos avisos se envían siempre."

#, python-format
msgid "A passkey named “%(name)s” was added to your account."
msgstr "Se añadió a su cuenta una llave de acceso llamada «%(name)s»."

msgid "Two-step verification was turned on for your account."
msgstr "Se activó la verificación en dos pasos en su cuenta."

msgid "An administrator turned off two-step verification for your account."
msgstr "Un administrador desactivó la verificación en dos pasos de su cuenta."

msgid "Two-step verification was turned off for your account."
msgstr "Se desactivó la verificación en dos pasos en su cuenta."

msgid "New recovery codes were made for your account; the old ones no longer work."
msgstr "Se crearon nuevos códigos de recuperación para su cuenta; los anteriores ya no funcionan."

#, python-format
msgid "An API token named “%(name)s” was created for your account."
msgstr "Se creó para su cuenta un token de API llamado «%(name)s»."

#, python-format
msgid "If this wasn't you, check your <a href=\"%(security_url)s\" style=\"%(a_style)s\">security page</a> and <a href=\"%(reset_url)s\" style=\"%(a_style)s\">reset your password</a> now."
msgstr "Si no fue usted, revise su <a href=\"%(security_url)s\" style=\"%(a_style)s\">página de seguridad</a> y <a href=\"%(reset_url)s\" style=\"%(a_style)s\">restablezca su contraseña</a> ahora."

msgid "Open your security page"
msgstr "Abrir su página de seguridad"

msgid "If this wasn't you, reset your password now and check your security page."
msgstr "Si no fue usted, restablezca su contraseña ahora y revise su página de seguridad."

msgid "Connect another account"
msgstr "Conectar otra cuenta"

msgid "Choose a service you also want to sign in with."
