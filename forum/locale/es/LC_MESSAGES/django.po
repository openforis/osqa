msgid "Sign in with your organisation's username and password."
msgstr "Inicie sesión con el nombre de usuario y la contraseña de su organización."

msgid "That username or email and password don't match. Check them and try again (the password is case-sensitive)."
msgstr "El nombre de usuario o correo y la contraseña no coinciden. Revíselos e inténtelo de nuevo (la contraseña distingue mayúsculas y minúsculas)."

msgid "This account can't sign in here. Please contact the site administrators."
msgstr "Esta cuenta no puede iniciar sesión aquí. Póngase en contacto con los administradores del sitio."

msgid "Enter your username or email and your password."
msgstr "Introduzca su nombre de usuario o correo y su contraseña."

msgid "Enter your password."
msgstr "Introduzca su contraseña."

msgid "Enter your username or email."
msgstr "Introduzca su nombre de usuario o correo."

msgid "Username or email"
msgstr "Nombre de usuario o correo"

msgid "Keep me signed in"
msgstr "Mantener la sesión iniciada"

msgid "For two weeks on this device. Leave it unticked on a shared computer."
msgstr "Durante dos semanas en este dispositivo. Déjelo sin marcar en un ordenador compartido."

msgid "Could not contact the login provider. Please try again later."
msgstr "No se pudo contactar con el proveedor de inicio de sesión. Inténtelo de nuevo más tarde."

msgid "This login method is not configured."
msgstr "Este método de inicio de sesión no está configurado."

msgid "The login was cancelled or refused by the provider."
msgstr "El proveedor canceló o rechazó el inicio de sesión."

msgid "The login request expired or is invalid. Please try again."
msgstr "La solicitud de inicio de sesión ha caducado o no es válida. Inténtelo de nuevo."

msgid "The login provider did not return an authorization code."
msgstr "El proveedor de inicio de sesión no devolvió un código de autorización."

msgid "The login provider did not return an access token."
msgstr "El proveedor de inicio de sesión no devolvió un token de acceso."

msgid "The login provider did not return a user id."
msgstr "El proveedor de inicio de sesión no devolvió un ID de usuario."

msgid "Google client ID"
msgstr "ID de cliente de Google"

msgid "OAuth client ID from the Google Cloud console (APIs & Services > Credentials)."
msgstr "ID de cliente OAuth de la consola de Google Cloud (APIs & Services > Credentials)."

msgid "oauth login sign-in social"
msgstr "oauth inicio de sesión acceso social"

msgid "Google client secret"
msgstr "Secreto de cliente de Google"

msgid "Shown next to the client ID in the Google Cloud console. Keep it secret."
msgstr "Se muestra junto al ID de cliente en la consola de Google Cloud. Manténgalo en secreto."

msgid "oauth login sign-in social password"
msgstr "oauth inicio de sesión acceso social contraseña"

msgid "GitHub client ID"
msgstr "ID de cliente de GitHub"

msgid "From a GitHub OAuth app (Settings > Developer settings > OAuth Apps)."
msgstr "De una aplicación OAuth de GitHub (Settings > Developer settings > OAuth Apps)."

msgid "GitHub client secret"
msgstr "Secreto de cliente de GitHub"

msgid "Generated on the OAuth app's page; GitHub shows it only once."
msgstr "Se genera en la página de la aplicación OAuth; GitHub lo muestra solo una vez."

msgid "Facebook app ID"
msgstr "ID de la aplicación de Facebook"

msgid "From developers.facebook.com (App settings > Basic)."
msgstr "De developers.facebook.com (App settings > Basic)."

msgid "oauth login sign-in social meta"
msgstr "oauth inicio de sesión acceso social meta"

msgid "Facebook app secret"
msgstr "Secreto de la aplicación de Facebook"

msgid "App settings > Basic, next to the app ID. Keep it secret."
msgstr "App settings > Basic, junto al ID de la aplicación. Manténgalo en secreto."

msgid "oauth login sign-in social meta password"
msgstr "oauth inicio de sesión acceso social meta contraseña"

msgid "The site's address (APP_URL in settings_local.py) starts with http://; sign-in providers only accept https:// redirect addresses."
msgstr "La dirección del sitio (APP_URL en settings_local.py) empieza por http://; los proveedores de inicio de sesión solo aceptan direcciones de redirección https://."

msgid "Fill in both the ID and the secret; until then the button stays hidden."
msgstr "Rellene tanto el ID como el secreto; hasta entonces el botón permanece oculto."

msgid "The sign-in page shows this provider."
msgstr "La página de inicio de sesión muestra este proveedor."

msgid "A Google client ID ends in .apps.googleusercontent.com; check that you copied the client ID, not the project ID or the secret."
msgstr "Un ID de cliente de Google termina en .apps.googleusercontent.com; compruebe que ha copiado el ID de cliente y no el ID del proyecto ni el secreto."

msgid "A Facebook app ID is a number, such as 1234567890123456."
msgstr "Un ID de aplicación de Facebook es un número, como 1234567890123456."

msgid "Sign in with Google"
msgstr "Iniciar sesión con Google"

msgid "Members sign in with their Google account; their email address arrives already confirmed."
msgstr "Los miembros inician sesión con su cuenta de Google; su dirección de correo electrónico llega ya confirmada."

msgid "Open the <a href=\"https://console.cloud.google.com/auth/overview\">Google Auth Platform</a> in the Google Cloud console (create a project first if you have none) and fill in the <strong>Branding</strong> page: app name, support email and your site's domain."
msgstr "Abra <a href=\"https://console.cloud.google.com/auth/overview\">Google Auth Platform</a> en la consola de Google Cloud (cree antes un proyecto si no tiene ninguno) y rellene la página <strong>Branding</strong>: nombre de la aplicación, correo de asistencia y el dominio de su sitio."

msgid "Under <strong>Audience</strong>, choose <strong>External</strong> and <strong>publish</strong> the app; while it is in testing only the test users you list can sign in."
msgstr "En <strong>Audience</strong>, elija <strong>External</strong> y <strong>publique</strong> la aplicación; mientras esté en pruebas, solo pueden iniciar sesión los usuarios de prueba que indique."

msgid "Under <strong>Clients</strong>, create a client of type <strong>Web application</strong> and add the redirect URI below to its <strong>Authorized redirect URIs</strong>."
msgstr "En <strong>Clients</strong>, cree un cliente de tipo <strong>Web application</strong> y añada el URI de redirección de abajo a sus <strong>Authorized redirect URIs</strong>."

msgid "Copy the <strong>Client ID</strong> and <strong>Client secret</strong> into the fields below and save. Then sign out and try the Google button on the sign-in page."
msgstr "Copie el <strong>Client ID</strong> y el <strong>Client secret</strong> en los campos de abajo y guarde. Después cierre la sesión y pruebe el botón de Google en la página de inicio de sesión."

msgid "Authorized redirect URI"
msgstr "URI de redirección autorizado"

msgid "Google Cloud console: OAuth clients"
msgstr "Consola de Google Cloud: clientes OAuth"

msgid "oauth openid login sign-in social google account"
msgstr "oauth openid inicio de sesión acceso social google cuenta"

msgid "Sign in with GitHub"
msgstr "Iniciar sesión con GitHub"

msgid "Members sign in with their GitHub account, handy for developer communities."
msgstr "Los miembros inician sesión con su cuenta de GitHub, algo práctico para comunidades de desarrolladores."

msgid "On GitHub, open <a href=\"https://github.com/settings/developers\">Settings &gt; Developer settings &gt; OAuth Apps</a> (or your organization's settings, so the app doesn't depend on one person) and choose <strong>New OAuth app</strong>."
msgstr "En GitHub, abra <a href=\"https://github.com/settings/developers\">Settings &gt; Developer settings &gt; OAuth Apps</a> (o la configuración de su organización, para que la aplicación no dependa de una sola persona) y elija <strong>New OAuth app</strong>."

#, python-brace-format
msgid "Enter the site's name, <code>{app_url}</code> as the <strong>Homepage URL</strong> and the callback URL below as the <strong>Authorization callback URL</strong>, then register the app."
msgstr "Introduzca el nombre del sitio, <code>{app_url}</code> como <strong>Homepage URL</strong> y la URL de devolución de llamada de abajo como <strong>Authorization callback URL</strong>, y registre la aplicación."

msgid "Copy the <strong>Client ID</strong>, then choose <strong>Generate a new client secret</strong> and copy the secret right away: GitHub shows it only once."
msgstr "Copie el <strong>Client ID</strong>, elija <strong>Generate a new client secret</strong> y copie el secreto enseguida: GitHub lo muestra solo una vez."

msgid "Paste both into the fields below and save."
msgstr "Pegue ambos en los campos de abajo y guarde."

msgid "Authorization callback URL"
msgstr "URL de devolución de llamada de autorización"

msgid "GitHub: creating an OAuth app"
msgstr "GitHub: crear una aplicación OAuth"

msgid "oauth login sign-in social developer"
msgstr "oauth inicio de sesión acceso social desarrollador"

msgid "Sign in with Facebook"
msgstr "Iniciar sesión con Facebook"

msgid "Members sign in with their Facebook account."
msgstr "Los miembros inician sesión con su cuenta de Facebook."

msgid "On <a href=\"https://developers.facebook.com/apps/\">Meta for Developers</a>, create an app with the use case <strong>Authenticate and request data from users with Facebook Login</strong>."
msgstr "En <a href=\"https://developers.facebook.com/apps/\">Meta for Developers</a>, cree una aplicación con el caso de uso <strong>Authenticate and request data from users with Facebook Login</strong>."

msgid "In the Facebook Login settings, add the redirect URI below to <strong>Valid OAuth Redirect URIs</strong>."
msgstr "En la configuración de Facebook Login, añada el URI de redirección de abajo a <strong>Valid OAuth Redirect URIs</strong>."

msgid "Under <strong>App settings &gt; Basic</strong>, fill in the privacy policy address, then copy the <strong>App ID</strong> and <strong>App secret</strong> into the fields below and save."
msgstr "En <strong>App settings &gt; Basic</strong>, rellene la dirección de la política de privacidad, copie el <strong>App ID</strong> y el <strong>App secret</strong> en los campos de abajo y guarde."

msgid "Switch the app to <strong>Live</strong>; in development mode only the app's own roles can sign in."
msgstr "Cambie la aplicación a <strong>Live</strong>; en modo de desarrollo solo pueden iniciar sesión los roles de la propia aplicación."

msgid "Valid OAuth Redirect URI"
msgstr "URI de redirección de OAuth válido"

msgid "Meta: Facebook Login for the web"
msgstr "Meta: Facebook Login para la web"

msgid "Bug Buster"
msgstr "Cazador de errores"

