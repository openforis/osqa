#, python-format
msgid "%(prefix)s Your %(app_name)s account has been deleted"
msgstr "%(prefix)s Su cuenta de %(app_name)s se ha eliminado"

msgid "Your personal data has been removed."
msgstr "Sus datos personales se han eliminado."

#, python-format
msgid "You receive this email because the account %(deleted_name)s at %(app_name)s was deleted. This is the last email we send to this address."
msgstr "Recibe este correo porque la cuenta %(deleted_name)s de %(app_name)s se ha eliminado. Es el último correo que enviamos a esta dirección."

#, python-format
msgid "Your account %(name)s has been deleted, as you asked. Your profile, email address, sign-in methods, passkeys, subscriptions, notifications and settings are removed, and every browser and device was signed out."
msgstr "Su cuenta %(name)s se ha eliminado, tal como pidió. Se han eliminado su perfil, su dirección de correo electrónico, sus métodos de inicio de sesión, llaves de acceso, suscripciones, notificaciones y ajustes, y se ha cerrado la sesión en todos los navegadores y dispositivos."

msgid "Your questions, answers and comments were deleted."
msgstr "Sus preguntas, respuestas y comentarios se han eliminado."

msgid "Your questions, answers and comments stay on the site, because other people's answers and discussions depend on them, but they show “deleted-user” instead of your name."
msgstr "Sus preguntas, respuestas y comentarios permanecen en el sitio, porque las respuestas y conversaciones de otras personas dependen de ellos, pero muestran «deleted-user» en lugar de su nombre."

msgid "If you didn't delete your account, contact the site administrators by replying to this email."
msgstr "Si usted no eliminó su cuenta, póngase en contacto con los administradores del sitio respondiendo a este correo."

#, python-format
msgid "%(prefix)s You already have an account on %(app_name)s"
msgstr "%(prefix)s Ya tiene una cuenta en %(app_name)s"

msgid "Someone tried to sign up with your email address."
msgstr "Alguien ha intentado registrarse con su dirección de correo electrónico."

#, python-format
msgid "You receive this email because someone tried to sign up at %(app_name)s with this address."
msgstr "Recibe este correo porque alguien ha intentado registrarse en %(app_name)s con esta dirección."

#, python-format
msgid "Someone (maybe you) tried to create a new account with this email address, but it already belongs to your account %(name)s. No new account was created."
msgstr "Alguien (quizá usted) ha intentado crear una cuenta nueva con esta dirección de correo electrónico, pero ya pertenece a su cuenta %(name)s. No se ha creado ninguna cuenta nueva."

msgid "Sign in"
msgstr "Iniciar sesión"

#, python-format
msgid "Forgot your password? <a href=\"%(reset_url)s\" style=\"%(a_style)s\">Choose a new one</a>. If it wasn't you, you can ignore this email."
msgstr "¿Ha olvidado su contraseña? <a href=\"%(reset_url)s\" style=\"%(a_style)s\">Elija una nueva</a>. Si no fue usted, puede ignorar este correo."

msgid "Forgot your password? Choose a new one"
msgstr "¿Ha olvidado su contraseña? Elija una nueva"

msgid "If it wasn't you, you can ignore this email."
msgstr "Si no fue usted, puede ignorar este correo."

msgid "Authentication settings"
msgstr "Configuración de autenticación"

msgid "Sign-in services"
msgstr "Servicios de inicio de sesión"

msgid "These are the external authentication providers currently associated with your account."
msgstr "Estos son los proveedores de autenticación externos asociados actualmente a su cuenta."

msgid "You currently have no external authentication provider associated with your account."
msgstr "Actualmente no tiene ningún proveedor de autenticación externo asociado a su cuenta."

msgid "Add new provider"
msgstr "Añadir un proveedor"

msgid "Create password"
msgstr "Crear contraseña"

msgid "This is where you can change your password. Make sure you remember it!"
msgstr "Aquí puede cambiar su contraseña. ¡Asegúrese de recordarla!"

msgid "Set a password so you can sign in with your username or email and a password."
msgstr "Establezca una contraseña para poder iniciar sesión con su nombre de usuario o correo y una contraseña."

msgid "Please correct the errors below."
msgstr "Corrija los errores indicados abajo."

msgid "Why sign in?"
msgstr "¿Por qué iniciar sesión?"

msgid "Ask questions and post answers"
msgstr "Formular preguntas y publicar respuestas"

msgid "Vote, comment and mark favourite questions"
msgstr "Votar, comentar y marcar preguntas como favoritas"

msgid "Get notified by email when someone answers"
msgstr "Recibir un aviso por correo electrónico cuando alguien responda"

msgid "Earn reputation and badges"
msgstr "Ganar reputación e insignias"

msgid "Check your inbox"
msgstr "Revise su bandeja de entrada"

#, python-format
msgid "If this address belongs to an account, we've sent it a link to choose a new password. The link works once, for %(minutes)s minute."
msgid_plural "If this address belongs to an account, we've sent it a link to choose a new password. The link works once, for %(minutes)s minutes."
msgstr[0] "Si esta dirección pertenece a una cuenta, le hemos enviado un enlace para elegir una contraseña nueva. El enlace funciona una vez, durante %(minutes)s minuto."
msgstr[1] "Si esta dirección pertenece a una cuenta, le hemos enviado un enlace para elegir una contraseña nueva. El enlace funciona una vez, durante %(minutes)s minutos."
msgstr[2] "Si esta dirección pertenece a una cuenta, le hemos enviado un enlace para elegir una contraseña nueva. El enlace funciona una vez, durante %(minutes)s minutos."

#, python-format
msgid "If this address belongs to an account that isn't confirmed yet, we've sent it a new confirmation link. It works once, for %(hours)s hour."
msgid_plural "If this address belongs to an account that isn't confirmed yet, we've sent it a new confirmation link. It works once, for %(hours)s hours."
msgstr[0] "Si esta dirección pertenece a una cuenta que aún no está confirmada, le hemos enviado un nuevo enlace de confirmación. Funciona una vez, durante %(hours)s hora."
msgstr[1] "Si esta dirección pertenece a una cuenta que aún no está confirmada, le hemos enviado un nuevo enlace de confirmación. Funciona una vez, durante %(hours)s horas."
msgstr[2] "Si esta dirección pertenece a una cuenta que aún no está confirmada, le hemos enviado un nuevo enlace de confirmación. Funciona una vez, durante %(hours)s horas."

#, python-format
msgid "Check your email to finish creating your account: open the link we sent to the address you entered to confirm it, then sign in. The link works once, for %(hours)s hour."
msgid_plural "Check your email to finish creating your account: open the link we sent to the address you entered to confirm it, then sign in. The link works once, for %(hours)s hours."
msgstr[0] "Revise su correo para terminar de crear su cuenta: abra el enlace que enviamos a la dirección que indicó para confirmarla y luego inicie sesión. El enlace funciona una vez, durante %(hours)s hora."
msgstr[1] "Revise su correo para terminar de crear su cuenta: abra el enlace que enviamos a la dirección que indicó para confirmarla y luego inicie sesión. El enlace funciona una vez, durante %(hours)s horas."
msgstr[2] "Revise su correo para terminar de crear su cuenta: abra el enlace que enviamos a la dirección que indicó para confirmarla y luego inicie sesión. El enlace funciona una vez, durante %(hours)s horas."

msgid "Nothing arrived after a few minutes? Check your spam folder, and that the address was typed correctly."
msgstr "¿No ha llegado nada después de unos minutos? Revise su carpeta de spam y compruebe que la dirección esté bien escrita."

