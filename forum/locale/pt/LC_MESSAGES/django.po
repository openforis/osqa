msgstr "Votar contra exige %(needed)d pontos de reputação (você tem %(have)d)."

#, python-format
msgid "A vote can't be changed more than %d day after it was cast."
msgid_plural "A vote can't be changed more than %d days after it was cast."
msgstr[0] "Um voto não pode ser alterado mais de %d dia depois de dado."
msgstr[1] "Um voto não pode ser alterado mais de %d dias depois de dado."

#, python-format
msgid "You have used your %d votes for today."
msgstr "Você já usou seus %d votos de hoje."

msgid "Accepting answers is turned off on this site."
msgstr "Aceitar respostas está desativado neste site."

msgid "Only the asker (or a moderator) can accept an answer."
msgstr "Só quem perguntou (ou um moderador) pode aceitar uma resposta."

msgid "This question already has an accepted answer."
msgid_plural "This question has reached the limit of accepted answers."
msgstr[0] "Esta pergunta já tem uma resposta aceita."
msgstr[1] "Esta pergunta atingiu o limite de respostas aceitas."

msgid "The author of this answer has reached the limit of accepted answers in this question."
msgstr "O autor desta resposta atingiu o limite de respostas aceitas nesta pergunta."

