msgstr "Um ID de app do Facebook é um número, como 1234567890123456."

msgid "Sign in with Google"
msgstr "Entrar com o Google"

msgid "Members sign in with their Google account; their email address arrives already confirmed."
msgstr "Os membros entram com a conta do Google; o endereço de e-mail chega já confirmado."

msgid "Open the <a href=\"https://console.cloud.google.com/auth/overview\">Google Auth Platform</a> in the Google Cloud console (create a project first if you have none) and fill in the <strong>Branding</strong> page: app name, support email and your site's domain."
msgstr "Abra a <a href=\"https://console.cloud.google.com/auth/overview\">Google Auth Platform</a> no console do Google Cloud (crie um projeto antes, se não tiver nenhum) e preencha a página <strong>Branding</strong>: nome do app, e-mail de suporte e o domínio do seu site."

msgid "Under <strong>Audience</strong>, choose <strong>External</strong> and <strong>publish</strong> the app; while it is in testing only the test users you list can sign in."
msgstr "Em <strong>Audience</strong>, escolha <strong>External</strong> e <strong>publique</strong> o app; enquanto estiver em teste, só os usuários de teste que você listar podem entrar."

msgid "Under <strong>Clients</strong>, create a client of type <strong>Web application</strong> and add the redirect URI below to its <strong>Authorized redirect URIs</strong>."
msgstr "Em <strong>Clients</strong>, crie um cliente do tipo <strong>Web application</strong> e adicione o URI de redirecionamento abaixo em <strong>Authorized redirect URIs</strong>."

msgid "Copy the <strong>Client ID</strong> and <strong>Client secret</strong> into the fields below and save. Then sign out and try the Google button on the sign-in page."
msgstr "Copie o <strong>Client ID</strong> e o <strong>Client secret</strong> para os campos abaixo e salve. Depois saia e teste o botão do Google na página de entrada."

msgid "Authorized redirect URI"
msgstr "URI de redirecionamento autorizado"

msgid "Google Cloud console: OAuth clients"
msgstr "Console do Google Cloud: clientes OAuth"

