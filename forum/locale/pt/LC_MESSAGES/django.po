msgstr "Credenciais do Google Cloud"

msgid "The google-auth package is missing."
msgstr "O pacote google-auth não está instalado."

msgid "Install the requirements: pip install -r requirements.txt."
msgstr "Instale os requisitos: pip install -r requirements.txt."

