msgstr "%(model)s respondeu, mas não terminou (%(reason)s)."

msgid "Try again; if it keeps happening, choose another model."
msgstr "Tente novamente; se continuar acontecendo, escolha outro modelo."

#, python-format
msgid "%(model)s answered, but not with the JSON it was asked for."
msgstr "%(model)s respondeu, mas não com o JSON solicitado."

msgid "Choose a model that supports JSON output, e.g. the default."
msgstr "Escolha um modelo que suporte saída JSON, por exemplo o padrão."

#, python-format
msgid "%(model)s answered in %(seconds).1f s."
msgstr "%(model)s respondeu em %(seconds).1f s."

