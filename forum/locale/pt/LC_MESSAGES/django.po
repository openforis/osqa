msgstr "Envie o token como “Authorization: Bearer <token>”."

msgid "This token is not valid. It may have been revoked."
msgstr "Este token não é válido. Ele pode ter sido revogado."

#, python-format
msgid "This token expired on %s. Create a new one on your account page."
msgstr "Este token expirou em %s. Crie um novo na página da sua conta."

msgid "This account is suspended, so its tokens can't be used."
msgstr "Esta conta está suspensa, então os tokens dela não podem ser usados."

msgid "Confirm your email address before using the API."
msgstr "Confirme seu endereço de e-mail antes de usar a API."

msgid "This site doesn't accept changes through the API at the moment."
msgstr "No momento, este site não aceita alterações pela API."

msgid "This needs a personal access token: send \"Authorization: Bearer <token>\"."
msgstr "Isto exige um token de acesso pessoal: envie “Authorization: Bearer <token>”."

#, python-format
msgid "This token doesn't have the %s scope."
msgstr "Este token não tem o escopo %s."

#, python-format
msgid "Too many requests: at most %(limit)d per minute. Try again in %(seconds)d seconds."
msgstr "Requisições demais: no máximo %(limit)d por minuto. Tente novamente em %(seconds)d segundos."

msgid "The administrators of this site have turned the API off."
msgstr "Os administradores deste site desativaram a API."

#, python-format
msgid "%(method)s is not allowed here; use %(allowed)s."
msgstr "%(method)s não é permitido aqui; use %(allowed)s."

