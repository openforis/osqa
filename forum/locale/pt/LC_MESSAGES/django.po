msgstr "Ainda não gerado (manage.py build_knowledge_index, todas as noites)."

#, python-format
msgid "The index was built with %(old)s; the next build embeds everything again with %(new)s."
msgstr "O índice foi gerado com %(old)s; a próxima geração cria novamente os embeddings de tudo com %(new)s."

