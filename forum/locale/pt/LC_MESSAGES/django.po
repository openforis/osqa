msgstr "Envie o corpo da requisição como JSON (Content-Type: application/json)."

#, python-format
msgid "The request body is larger than %d KB."
msgstr "O corpo da requisição é maior que %d KB."

msgid "The request body is not valid JSON."
msgstr "O corpo da requisição não é um JSON válido."

msgid "The request body must be a JSON object."
msgstr "O corpo da requisição deve ser um objeto JSON."

#, python-format
msgid "%s must be a string."
msgstr "%s deve ser um texto."

msgid "Must be a string."
msgstr "Deve ser um texto."

#, python-format
msgid "%s is required."
msgstr "%s é obrigatório."

msgid "This field is required."
msgstr "Este campo é obrigatório."

