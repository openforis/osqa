msgid "Add your site's domain (the host name of <code>{app_url}</code>, without https://), and <code>localhost</code> if you also test on your own computer."
msgstr "Adicione o domínio do seu site (o nome de host de <code>{app_url}</code>, sem https://) e <code>localhost</code> se você também testa no seu próprio computador."

msgid "Copy the <strong>site key</strong> and the <strong>secret key</strong> into the fields below and save."
msgstr "Copie a <strong>chave do site</strong> e a <strong>chave secreta</strong> para os campos abaixo e salve."

