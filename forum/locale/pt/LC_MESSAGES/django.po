msgid "General settings for the OSQA forms."
msgstr "Configurações gerais dos formulários do OSQA."

msgid "Enable community wiki"
msgstr "Ativar wiki da comunidade"

msgid "Can questions or answers be marked as community wiki."
msgstr "Se perguntas ou respostas podem ser marcadas como wiki da comunidade."

msgid "Limit tag creation"
msgstr "Limitar criação de etiquetas"

msgid "Limit tag creation to super users, staff or users with a minimum reputation."
msgstr "Limita a criação de etiquetas a superusuários, equipe ou usuários com uma reputação mínima."

msgid "Minimum number of characters for a question's title"
msgstr "Número mínimo de caracteres do título de uma pergunta"

msgid "The minimum number of characters a user must enter into the title field of a question."
msgstr "O número mínimo de caracteres que um usuário deve inserir no campo de título de uma pergunta."

msgid "Minimum number of characters for a question's content"
msgstr "Número mínimo de caracteres do conteúdo de uma pergunta"

msgid "The minimum number of characters a user must enter into the content field of a question."
msgstr "O número mínimo de caracteres que um usuário deve inserir no campo de conteúdo de uma pergunta."

msgid "Empty question content"
msgstr "Conteúdo de pergunta vazio"

msgid "If a question's content can be empty."
msgstr "Se o conteúdo de uma pergunta pode ficar vazio."

msgid "Required number of tags per question"
msgstr "Número obrigatório de etiquetas por pergunta"

msgid "How many tags are required in questions."
msgstr "Quantas etiquetas são obrigatórias nas perguntas."

msgid "Maximum number of tags per question"
msgstr "Número máximo de etiquetas por pergunta"

msgid "How many tags are allowed in questions."
msgstr "Quantas etiquetas são permitidas nas perguntas."

msgid "Minimum length of a tag"
msgstr "Tamanho mínimo de uma etiqueta"

msgid "How short a tag can be."
msgstr "O quão curta uma etiqueta pode ser."

msgid "Maximum length of a tag"
msgstr "Tamanho máximo de uma etiqueta"

msgid "How long a tag can be."
msgstr "O quão longa uma etiqueta pode ser."

